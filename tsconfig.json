{
  "compilerOptions": {
    "target": "es2018",
    "lib": ["ES2018", "DOM"],
    "allowJs": true,
    "jsx": "react",
    "outDir": "./dist", // Add this line to specify output directory
    "rootDir": "./src",  // Add this to clearly define source directory
    "moduleResolution": "node", // Add this for proper module resolution
    "esModuleInterop": true,    // Helps with import compatibility
    "resolveJsonModule": true   // Useful for importing JSON files
  },
  "include": ["src/**/*", "NotFound.jsx"],
  "exclude": ["node_modules", "dist"] // Add this to prevent processing output files
}